{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.platform/schemas/registry.schema.json",
  "title": "RegistryContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "registry_type",
    "entry_id",
    "entry_version",
    "status",
    "tenant_scope",
    "owner",
    "created_at",
    "created_by",
    "changelog",
    "payload_ref"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "registry_type": {
      "type": "string",
      "enum": [
        "AgentRegistry",
        "ToolRegistry",
        "WorkflowRegistry",
        "PromptRegistry",
        "ModelRegistry",
        "PolicyRegistry",
        "PermissionRegistry",
        "SkillRegistry",
        "MemoryRegistry",
        "KnowledgeRegistry"
      ]
    },
    "entry_id": { "type": "string", "minLength": 1 },
    "entry_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated", "retired"] },
    "tenant_scope": {
      "type": "string",
      "enum": ["global", "tenant_override_allowed", "tenant_only"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "author", "notes"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "date": { "type": "string", "format": "date-time" },
          "author": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "payload_ref": { "type": "string", "minLength": 1 },
    "supersedes": { "type": "string", "pattern": "^\\S+@\\d+\\.\\d+\\.\\d+$" },
    "deprecation_note": { "type": "string" },
    "cache_ttl_seconds": { "type": "integer", "minimum": 0 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  }
}
