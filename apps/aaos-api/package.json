{
  "name": "aaos-api",
  "version": "0.1.0",
  "private": true,
  "description": "AAOS API — NestJS HTTP backbone for the AAOS Business Layer. Exposes Meta Ads campaign endpoints, verdict execution, and Meta webhook ingestion.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "vitest run test/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prestart:dev": "node ../../scripts/free-port.mjs 3000",
    "prestart": "node ../../scripts/free-port.mjs 3000"
  },
  "dependencies": {
    "@aos/asset-library": "workspace:*",
    "@aos/branch-manager": "workspace:*",
    "@aos/capi-connector": "workspace:*",
    "@aos/common": "workspace:*",
    "@aos/config": "workspace:*",
    "@aos/creative-agent": "workspace:*",
    "@aos/creative-connector": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/lead-store": "workspace:*",
    "@aos/logger": "workspace:*",
    "@aos/meta-ads-agent": "workspace:*",
    "@aos/meta-ads-connector": "workspace:*",
    "@aos/meta-organic-connector": "workspace:*",
    "@aos/mobix-web-scraper": "workspace:*",
    "@aos/objective-engine": "workspace:*",
    "@aos/telemetry": "workspace:*",
    "@aos/whatsapp-connector": "workspace:*",
    "@fastify/multipart": "^8.3.1",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^4.28.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdfjs-dist": "^6.3.289",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@electric-sql/pglite": "0.3.14",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.7.26",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.5",
    "msw": "^2.3.5",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
