# AAOS API — environment variables. Copy to .env(.local) and fill in real values.
# Validated at process startup by src/config/aaos-api.config.ts (Zod) — the process fails fast
# with a clear error and a non-zero exit code if any required variable is missing/invalid.

# --- Server ---
PORT=3000
NODE_ENV=development
# Shared secret compared (constant-time) against the incoming x-api-key header on
# /api/v1/campaigns and /api/v1/verdicts.
API_KEY=change-me-to-a-long-random-secret

# --- Meta Ads (Meta Marketing Graph API) ---
META_API_VERSION=v21.0
# A System User access token with ads_management/ads_read permission on every account below.
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated act_<digits> ids — parsed into an array by src/config/aaos-api.config.ts.
META_AD_ACCOUNT_IDS=act_752604553578354,act_999999999999999
# Configured on Meta's webhook subscription page — must match exactly for the GET handshake.
META_WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-verify-token
# The Meta App Secret — used to HMAC-SHA256-verify X-Hub-Signature-256 on every inbound POST.
META_WEBHOOK_APP_SECRET=change-me-to-the-meta-app-secret

# --- AAOS ---
AAOS_TENANT_ID=dss-motor

# --- WhatsApp Cloud API (AAOS-W2A @aos/whatsapp-connector) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=

# --- WABA per branch ---
WABA_ID_BINTARO=
PHONE_NUMBER_ID_BINTARO=
PHONE_NUMBER_BINTARO=+62...

WABA_ID_CINERE=
PHONE_NUMBER_ID_CINERE=
PHONE_NUMBER_CINERE=+62...

# Judgment call (see @aos/whatsapp-connector's README "Branch.PONDOK_BAMBU resolution"): these
# three env var NAMES are kept exactly as originally specified, but src/config/
# to-whatsapp-connector-config.ts maps this WABA's `branch` field to `Branch.UMUM` — the real
# `Branch` enum (re-exported from @aos/meta-ads-connector) has no `PONDOK_BAMBU` member.
WABA_ID_PONDOK_BAMBU=
PHONE_NUMBER_ID_PONDOK_BAMBU=
PHONE_NUMBER_PONDOK_BAMBU=+62...

WABA_ID_BANDUNG=
PHONE_NUMBER_ID_BANDUNG=
PHONE_NUMBER_BANDUNG=+62...

# --- Supabase (AAOS-W2E @aos/lead-store) ---
# See packages/lead-store/supabase/README.md for how to get these from the Supabase dashboard.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_KEY=eyJxxx...
