# OpenAI (AAOS-LLM-TAMARA src/modules/llm) — left empty on purpose, no real key available to
# commit here. With this unset/empty, POST /api/v1/llm/{analyze,creative-brief,chat} respond with
# `{ available: false, reason: "NO_API_KEY", ... }` instead of calling OpenAI, so the dashboard
# falls back to rule-based analysis. Fill in a real sk-... key locally to enable live LLM calls.
OPENAI_API_KEY=

# AAOS Simulator (AAOS-DASHBOARD-SIMULASI) — base URL of the sibling `apps/aaos-simulator` app's
# `POST /api/simulate` (Jessy conversation simulation + AI Judge scoring). Left empty on purpose:
# with this unset, the new simulation module's Jessy/Judge stage is honestly recorded as
# unavailable instead of being faked. Point this at wherever `apps/aaos-simulator` is actually
# running (e.g. `http://localhost:4100` in local dev, once that app has its own PORT configured).
AAOS_SIMULATOR_BASE_URL=

# Google Cloud Storage (AAOS-SCRAPER-ASSET-LIBRARY — src/modules/assets + src/modules/scraper) —
# backs @aos/asset-library's GcsStorageClient (unit photos from the scraper, AI creatives from Kai).
# Left empty on purpose: no real service-account key is committed here. With GCS_PROJECT_ID empty (or
# both credential vars empty), app.module.ts SKIPS composing @aos/asset-library entirely — the app
# still boots and every other endpoint works, /api/v1/assets/* returns 503 "not configured", and the
# scraper still scrapes + persists unit metadata to `scraped_units`, just without downloading photos
# into GCS. Set GCS_PROJECT_ID plus exactly one of GCS_CREDENTIALS (the service-account JSON as a
# single-line string) or GCS_KEY_FILE_PATH (a path to that JSON on disk) to enable it. The service
# account must have a private key, since GET /api/v1/assets/:id/download signs URLs locally.
GCS_BUCKET_NAME=aoos
GCS_PROJECT_ID=
GCS_CREDENTIALS=
GCS_KEY_FILE_PATH=

# mobixbydss.id inventory listing URL the scraper fetches (AAOS-SCRAPER-ASSET-LIBRARY). Defaults to
# the real production listing when unset.
MOBIX_LISTING_URL=https://mobixbydss.id/produk

# Kie AI API key (AAOS-CREATIVE-REVIEW — src/modules/creative-packages) — backs the REAL Kai
# generation pipeline (@aos/creative-agent -> @aos/creative-connector -> Kie AI's veo3_fast video +
# google/nano-banana-pro image endpoints). THIS KEY SPENDS REAL MONEY when a manager clicks
# "Kirim ke Kai". Left empty on purpose: with it empty (or with GCS above unconfigured, since Kai
# needs the asset library for both source photos and generated-media storage), app.module.ts SKIPS
# composing the Kai runtime — the app still boots, the creative review queue still reads/writes real
# Supabase rows, and POST /api/v1/creative-packages/:id/generate returns an honest 503 naming the
# missing vars instead of pretending a job was queued.
#
# NOTE: nothing in this app triggers generation on a timer or without a human. There is no cron and
# no "full auto mode"; this key is only ever exercised by an explicit per-brief click.
KIE_AI_API_KEY=

# AAOS Dashboard base URL (AAOS-MULTI-TENANT-SUPERADMIN-PROPERTY — src/modules/superadmin) — used
# only to build the `redirectTo` for the real "Login as Tenant" impersonation flow
# (supabase.auth.admin.generateLink({ type: 'magiclink' })). Left empty on purpose: with this
# unset, generateLink omits redirectTo and Supabase falls back to the project's configured Site
# URL — impersonation still works. Point this at wherever apps/aaos-dashboard is really running
# (e.g. http://localhost:3100 in local dev) to land the tenant admin back on /dashboard directly.
AAOS_DASHBOARD_BASE_URL=