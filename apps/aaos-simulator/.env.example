# apps/aaos-simulator — AAOS-DASHBOARD-SIMULASI coordinator note.
#
# This app previously had no `.env`/`.env.example` of its own at all (an earlier task flagged its
# `.env` as containing `aaos-api`-shaped config — WABA/GCS/CAPI settings — that this app never
# reads; `@aos/conversation-simulator`/`@aos/ai-judge` need no external config, so that file was
# simply the wrong template copied into the wrong app). This file replaces that: the only real
# runtime knob this app has.
#
# `next dev`/`next start` both respect PORT. Set this to something other than 3000 (aaos-api's
# default PORT) and 3001-ish dashboard ports so `AAOS_SIMULATOR_BASE_URL` in `apps/aaos-api/.env`
# can point at a stable, non-conflicting address in local dev.
PORT=4100

# AAOS-MULTI-TENANT-SUPERADMIN-PROPERTY Phase 8 (spec section 12 point 3/4) — the 2nd real runtime
# knob this app has: `POST /api/simulate`'s `src/lib/aaos-api-client.ts` calls `apps/aaos-api`'s
# `GET /api/v1/listings/:id` to resolve the real listing data for a `vertical: "PROPERTY"` request's
# `listingId`, same `AAOS_API_BASE_URL`/`AAOS_API_KEY`/`x-api-key` convention
# `apps/aaos-dashboard`'s `src/lib/api.ts` already establishes. Left unset in local dev is a real,
# honest degraded state (the fetch resolves to `undefined`, so the PROPERTY composition still
# succeeds with 0 listings), not a hard failure — never required for the automotive path.
AAOS_API_BASE_URL=
AAOS_API_KEY=

# Self-Learning AI bridge phase — reuses the SAME two knobs above (`AAOS_API_BASE_URL`/
# `AAOS_API_KEY`) to call `apps/aaos-api`'s NEW `POST /api/v1/ai-judge/simulation-batch` after every
# real `POST /api/simulate-all` run, feeding this app's real per-persona AI Judge scores into
# aaos-api's existing Self-Improving pipeline. See `src/lib/learning-bridge.ts` for the full
# reasoning and the honest best-effort/never-blocking contract.
#
# REAL TENANT-RESOLUTION FINDING (this app has zero tenant concept of its own — confirmed, no
# `tenantId`/`TENANT_ID` reference existed anywhere in this codebase before this phase — and its
# own `package.json` describes it as "an internal Next.js tool for DSS Motor", i.e. genuinely
# single-tenant today): left unset, the bridge call sends NO `x-tenant-id` header at all, and
# `apps/aaos-api`'s own `common/tenant-context.ts` `DEFAULT_TENANT_ID` ("dss-motor" — the exact
# same literal every existing table's `tenant_id` column default already resolves to) applies —
# the honest, zero-new-mechanism default for this tool's one real real-world deployment. Set this
# explicitly only if this tool is ever pointed at a genuinely different/multi-tenant deployment.
AAOS_SIMULATOR_TENANT_ID=

# Self-Learning AI, Phase C wiring (2nd half) — real runtime switch for `@aos/sales-agent`'s
# LLM-backed `LlmResponseGenerator`. Left unset/`false` (default), every simulate run uses the
# pure rule-based `ResponseGenerator` — today's unchanged behavior. Set `CLARA_LLM_REPLY_ENABLED=
# true` AND a real, non-empty `OPENAI_API_KEY` to have Clara's simulated replies actually come
# from the LLM (and therefore actually reflect `clara_system_prompt`'s active override, per the
# fetch wired above). An accidental `true` with no real key never wires the LLM generator either
# (`SalesAgentConfig.openaiApiKey`'s own doc) — this can never silently break a run.
CLARA_LLM_REPLY_ENABLED=false
OPENAI_API_KEY=
