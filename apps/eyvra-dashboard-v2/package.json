{
  "name": "eyvra-dashboard-v2",
  "version": "0.1.0",
  "private": true,
  "description": "EYVRA V2 — fresh visual/UX rebuild of the Command Center, built as an independent Next.js app (peer of apps/eyvra-dashboard, not a fork). Same real Supabase auth + apps/aaos-api backend, re-implemented rather than cross-imported.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "predev": "node ../../scripts/free-port.mjs 3003",
    "prestart": "node ../../scripts/free-port.mjs 3003"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tremor/react": "^3.18.7",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
