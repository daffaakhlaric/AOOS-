{
  "name": "aos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Automotive Operating System (AOS) — monorepo root. Foundation phase only, per docs/PROMPT-005.1-CORE-RUNTIME-FOUNDATION.md.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "clean": "bash scripts/clean.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.5",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node scripts/lint-staged-eslint.cjs"
    ],
    "*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
