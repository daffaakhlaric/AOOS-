{
  "name": "@aos/node-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Node Runtime — validates Nodes, creates Node Instances, and manages Node lifecycle for every Node Type/Category (including AI-native contracts). Does not execute workflow graphs, Capabilities, Tools, or Connectors.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/logger": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/types": "workspace:*",
    "@aos/workflow-definition": "workspace:*",
    "semver": "^7.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^2.0.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
