{
  "name": "@aos/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Pino-based structured logger with request/correlation/trace ID propagation for AOS.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/types": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^2.0.5",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "@types/node": "^20.14.0"
  }
}
