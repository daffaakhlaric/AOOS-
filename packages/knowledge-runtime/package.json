{
  "name": "@aos/knowledge-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Knowledge Runtime — the runtime lifecycle layer for Knowledge Assets (instances, sessions, state machine, loader, resolver, registry, middleware, validation, metrics, health) bridging @aos/knowledge-engine to Workflow Runtime, Memory, Prompt Intelligence, Capability Runtime, and Agent Runtime. Manages runtime state only — no embeddings, vector search, RAG, retrieval, chunking, synchronization, or LLM operations.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/knowledge-engine": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "@aos/workflow-definition": "workspace:*",
    "@aos/workflow-execution": "workspace:*",
    "@aos/workflow-integration": "workspace:*",
    "@aos/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^2.0.5"
  }
}
