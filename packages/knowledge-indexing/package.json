{
  "name": "@aos/knowledge-indexing",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Knowledge Indexing — the vendor-neutral indexing layer (Keyword/Metadata/Namespace/Relationship/Policy/Permission/Template/Tag/Category/Language/Workspace/Tenant/Department/Collection/AssetType/EmbeddingReference/Hybrid indexes) that prepares searchable indexes for future retrieval. Creates, updates, maintains, validates, and optimizes indexes only — no retrieval, no query answering, no RAG, no LLM calls, no embedding generation.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/knowledge-engine": "workspace:*",
    "@aos/knowledge-runtime": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.5"
  }
}
