{
  "name": "@aos/knowledge-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Knowledge Engine — the canonical Knowledge Domain (assets, workspaces, namespaces, relationships, lifecycle, policy, permission, versioning, templates, metadata) every future AOS module consumes knowledge through. Defines the domain only — no embeddings, vector search, RAG, chunking, retrieval, synchronization, or LLM operations.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/logger": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "@aos/types": "workspace:*",
    "@aos/workflow-definition": "workspace:*",
    "@aos/workflow-execution": "workspace:*",
    "@aos/workflow-integration": "workspace:*",
    "@aos/workflow-runtime": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
