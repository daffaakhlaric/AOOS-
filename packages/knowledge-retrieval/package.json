{
  "name": "@aos/knowledge-retrieval",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Knowledge Retrieval — the vendor-neutral retrieval orchestrator every future Agent uses to retrieve enterprise knowledge (never querying indexes or vector databases directly). Orchestrates Query Validation, Permission/Policy resolution, Search Strategy dispatch, Ranking, Filtering, and Result assembly only — no embedding generation, no vector database, no LLM, no AI reasoning, no prompt engineering, no memory, no synchronization.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/knowledge-engine": "workspace:*",
    "@aos/knowledge-indexing": "workspace:*",
    "@aos/knowledge-runtime": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@aos/workflow-execution": "workspace:*",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
