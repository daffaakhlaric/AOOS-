{
  "name": "@aos/workflow-integration",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Workflow Integration — the integration bridge between Workflow Runtime and every future runtime (Capability/Tool/Connector/Knowledge/Memory/AI Gateway/Model Router/Agent/Prompt/Experience). Defines contracts, adapters, and orchestration only — executes nothing.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/logger": "workspace:*",
    "@aos/node-runtime": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "@aos/types": "workspace:*",
    "@aos/workflow-definition": "workspace:*",
    "@aos/workflow-execution": "workspace:*",
    "@aos/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.5"
  }
}
