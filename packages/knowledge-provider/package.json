{
  "name": "@aos/knowledge-provider",
  "version": "0.1.0",
  "private": true,
  "description": "AOS Enterprise Knowledge Provider — the vendor-neutral abstraction layer between the Enterprise Knowledge Platform and every external knowledge source. Every future connector exposes knowledge through a Provider registered here. Orchestrates Provider registration, capability resolution, metadata, lifecycle, and validation only — no OAuth, no API clients, no connector SDKs, no synchronization, no retrieval, no embedding, no memory, no LLM, no provider-specific logic.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aos/common": "workspace:*",
    "@aos/errors": "workspace:*",
    "@aos/event-bus": "workspace:*",
    "@aos/knowledge-engine": "workspace:*",
    "@aos/knowledge-indexing": "workspace:*",
    "@aos/knowledge-retrieval": "workspace:*",
    "@aos/knowledge-runtime": "workspace:*",
    "@aos/knowledge-synchronization": "workspace:*",
    "@aos/registry": "workspace:*",
    "@aos/runtime-kernel": "workspace:*",
    "@aos/scheduler": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aos/eslint-config": "workspace:*",
    "@aos/testing": "workspace:*",
    "@aos/tsconfig": "workspace:*",
    "@aos/vitest-config": "workspace:*",
    "@aos/workflow-execution": "workspace:*",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
